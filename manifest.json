{
  "manifest_version": 3,
  "name": "LinguaPlay — Japanese Video Learning",
  "version": "1.0.0",
  "description": "Japanese subtitles, sentence translations, Jimaku search, AI explanations and Anki on YouTube, Netflix and other video sites.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open LinguaPlay Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "js/youtube-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.youtube.com/watch*",
        "*://*.youtube.com/*",
        "https://*.netflix.com/*",
        "https://*.primevideo.com/*",
        "https://*.disneyplus.com/*",
        "https://*.hulu.com/*",
        "https://*.crunchyroll.com/*",
        "https://*.vimeo.com/*"
      ],
      "js": [
        "lib/wanakana.min.js",
        "js/japanese-parser.js",
        "lib/yomitan-deinflector.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "nativeMessaging",
    "tabs"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://lrclib.net/*",
    "http://lyrics.kugou.com/*",
    "https://translate.googleapis.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.netflix.com/*",
    "https://*.primevideo.com/*",
    "https://*.disneyplus.com/*",
    "https://*.hulu.com/*",
    "https://*.crunchyroll.com/*",
    "https://*.vimeo.com/*",
    "https://jimaku.cc/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "options.html",
        "options.css",
        "options.js"
      ],
      "matches": [
        "*://*.youtube.com/*",
        "https://*.netflix.com/*",
        "https://*.primevideo.com/*",
        "https://*.disneyplus.com/*",
        "https://*.hulu.com/*",
        "https://*.crunchyroll.com/*",
        "https://*.vimeo.com/*"
      ]
    }
  ]
}
