{
  "manifest_version": 3,
  "name": "LinguaPlay for YouTube",
  "version": "1.0.0",
  "description": "Learn Japanese directly on YouTube with clickable subtitles, furigana, AI explanations, Sensei Chat, and Anki cards.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinguaPlay for YouTube",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "js/youtube-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.youtube.com/watch*",
        "*://*.youtube.com/*"
      ],
      "js": [
        "lib/wanakana.min.js",
        "js/japanese-parser.js",
        "lib/yomitan-deinflector.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "nativeMessaging",
    "activeTab",
    "scripting",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://lrclib.net/*",
    "http://lyrics.kugou.com/*",
    "http://*/*",
    "https://*/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*",
    "https://api.deepseek.com/*",
    "https://translate.googleapis.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "options.html",
        "options.css",
        "options.js"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ]
    }
  ]
}
